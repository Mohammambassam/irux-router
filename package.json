{
  "name": "irux-router",
  "private": false,
  "version": "0.3.0",
  "description": "A lightweight client-side router for React",
  "type": "module",
  "main": "./dist/irux-router.cjs",
  "module": "./dist/irux-router.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/irux-router.js",
      "require": "./dist/irux-router.cjs"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "react",
    "router",
    "routing",
    "navigation",
    "history-api",
    "irux-router"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
